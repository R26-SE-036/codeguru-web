# Copy to .env beside docker-compose.yml on the server. None of these are
# secrets; the secrets are in env/, written by prepare-env.sh.

# <account-id>.dkr.ecr.ap-southeast-2.amazonaws.com
REGISTRY=
# Printed by build-and-push.sh at the end of a build.
TAG=

# The Elastic IP with dots as dashes, until there is a real domain.
CADDY_SITE=3-106-2-190.sslip.io
PUBLIC_ORIGIN=https://3-106-2-190.sslip.io

AWS_REGION=ap-southeast-2
CODE_RUNNER_LAMBDA_FUNCTION=codeguru-code-runner
