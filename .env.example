# ============================================================================
# codeguru-web — the platform's web tier and backend-for-frontend.
#
# Copy to .env.local for development. Every value here is SERVER-side: none of
# these are NEXT_PUBLIC_*, and none reach the browser. That is the point — the
# browser learns no backend URL and holds no token.
# ============================================================================

# ── Session ──
# Seals the httpOnly session cookie (JWE, A256GCM). REQUIRED — the app cannot
# authenticate anyone without it, and there is deliberately no default.
#
# Exactly 32 bytes. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
#
# Rotating it signs everyone out, because existing cookies can no longer be
# opened. That is a safe operation, just a noticeable one.
SESSION_ENCRYPTION_KEY=

# ── Backends ──
# In development these fall back to the ports below. In production they are
# REQUIRED and the app refuses to start without them: falling back to localhost
# in a deployed environment fails silently, which is exactly how PairPath spent
# months posting its feature vectors at Code Coach's port.
CODE_COACH_URL=http://127.0.0.1:8000
STUDY_GUIDER_URL=http://127.0.0.1:8010
PAIRPATH_URL=http://127.0.0.1:3001
GAMIFICATION_URL=http://127.0.0.1:3002

# ── Notes ──
# There is no ALLOWED_REDIRECTS list here, and no dev-login flag. Both existed
# because the four frontends sat on four origins: the portal had to hand tokens
# across an origin boundary, and that handoff had to be guarded against being
# an open redirect. One origin removes the mechanism and the guard together.
#
# PairPath is the one backend given a different credential. It issues its own
# JWT from a Code Coach token via POST /auth/exchange, because its Socket.IO
# handshake verifies its own signature. If PAIRPATH_URL is unreachable at
# sign-in the exchange fails soft: everything else works, and the pairing routes
# answer 503 rather than blocking the whole session.

# ── Socket.IO, development only ──
# Deployed, the load balancer routes /pair-ws/* to PairPath and the browser
# connects same-origin. Locally nothing serves that path - it answers 308, not
# a socket - so point this straight at PairPath for development.
#
# Leave it UNSET in a deployed environment: setting it bypasses the load
# balancer and reintroduces a cross-origin connection. It is a host, not a
# secret, which is why it is the one NEXT_PUBLIC_* value here - a WebSocket
# cannot be proxied through a route handler, so the browser must know it.
NEXT_PUBLIC_PAIR_WS_URL=http://127.0.0.1:3001
